{
  "description": "Defaults for bounded long ComfyUI responses",
  "long_sampler": {
    "target_tokens": 8192,
    "segment_tokens": 1536,
    "summary_tokens": 256,
    "max_segments": 8,
    "num_inference_steps": 48,
    "t_min": 0.4,
    "t_max": 0.8,
    "entropy_bound": 0.1,
    "confidence": 0.005,
    "temperature": 0.2,
    "repetition_penalty": 1.0,
    "repetition_context_size": 2048,
    "repetition_guard": true,
    "max_retries": 2,
    "retry_seed_stride": 1,
    "thinking": false,
    "timeout_seconds": 21600
  },
  "loader": {
    "base_url": "http://127.0.0.1:8080",
    "model": "mlx-community/diffusiongemma-26B-A4B-it-4bit",
    "timeout_seconds": 10
  },
  "notes": [
    "Connect the Loader to MLX DiffusionGemma Long Sampler.",
    "Connect text and summary to separate PreviewAny nodes.",
    "segment_tokens must stay between 1024 and 2048."
  ]
}
